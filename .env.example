# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API keys), or run:
#   npx supabase projects api-keys --project-ref <ref>
# Only client-side values belong here: the project URL and the *publishable* key, which ships in
# the app and is safe because every table is behind row level security. Never a secret or
# service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
